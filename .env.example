# ========================================================
# LLM API Configuration (兼容 OpenAI 协议端点)
# 支持 DeepSeek, OpenAI, 通义千问, 智谱 AI, Moonshot, Ollama 等
# ========================================================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.2

# 智谱示例
# OPENAI_API_KEY=your_zhipu_api_key_here
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_MODEL_NAME=glm-4.7-flash

# 千问示例
# OPENAI_API_KEY=your_qwen_api_key_here
# OPENAI_BASE_URL=https://llm-xbhpkgyq039qluem.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL_NAME=qwen3.8-flash

# ========================================================
# 系统运行时配置
# ========================================================
# 工程师与测试员自愈重构最大循环次数 (避免无限循环)
MAX_ITERATIONS=3

# 是否在本地真实执行测试沙箱 (True/False)
ENABLE_REAL_CODE_EXECUTION=True
